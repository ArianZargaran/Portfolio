# Copy to .env and fill in. Never commit .env.
# Powers the RAG-backed reply generation on /skills (see app/routes/api.chat.tsx).
# Without these, that endpoint automatically falls back to the static
# keyword-matched replies in app/utils/skills-chat.ts — the site still works.

# Anthropic API key — generates the chat reply from retrieved context.
ANTHROPIC_API_KEY=

# Voyage AI API key — embeds the knowledge base and each incoming question
# for retrieval. https://www.voyageai.com
VOYAGE_API_KEY=

# --- Scene state (app/server/scene-config.server.ts) ---------------------
# Calendar provider: auto-detected from the vars below; force with
# ical | google | mock | none. "mock" = fixed v3.2 scene for local dev.
SCENE_CALENDAR_PROVIDER=
# PRIMARY: the scene calendar's "Secret address in iCal format". It is a
# credential: never commit, log or expose it.
SCENE_CALENDAR_ICAL_URL=
# ALTERNATIVE: Google service account with read-only access to the calendar.
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
SCENE_CALENDAR_ID=
# Home time zone for time-of-day slots (default America/Chicago).
SCENE_TIME_ZONE=
# Slot time zone while travelling. Default "event": the calendar event's own
# zone (then the geocoded place's), falling back to America/Chicago. Set an
# IANA zone to pin one zone for all trips.
SCENE_TRAVEL_TIME_ZONE=
# Weather: Open-Meteo, no key needed.

# --- Feature flags (app/features.ts), all default OFF ----------------------
# 1 = enable the paused skills chat (/skills, its nav entry, /api/chat).
FEATURE_SKILLS_CHAT=
